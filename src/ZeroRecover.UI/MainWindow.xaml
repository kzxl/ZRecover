<Window x:Class="ZeroRecover.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ZeroRecover.UI.ViewModels"
        xmlns:components="clr-namespace:ZeroRecover.UI.Views.Components"
        xmlns:models="clr-namespace:ZeroRecover.Core.Models;assembly=ZeroRecover.Core"
        Title="ZeroRecover — Sovereign Deep Data Recovery Suite" 
        Icon="app.ico"
        Height="840" Width="1280" MinHeight="660" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/> <!-- Left Control Rail -->
            <ColumnDefinition Width="*"/>   <!-- Main Recovery Workspace -->
        </Grid.ColumnDefinitions>

        <!-- ========================================================= -->
        <!-- LEFT CONTROL & STORAGE RAIL                               -->
        <!-- ========================================================= -->
        <Border Grid.Column="0" Background="{DynamicResource BgCardBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,0,1,0"
                Padding="16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Brand Header -->
                    <RowDefinition Height="Auto"/> <!-- Drive Selector Card -->
                    <RowDefinition Height="Auto"/> <!-- Volume Specs & Usage Card -->
                    <RowDefinition Height="*"/>    <!-- Recovery Architecture Modes -->
                    <RowDefinition Height="Auto"/> <!-- Sovereign Safe Barrier Status -->
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="app.png" Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ZeroRecover" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Border Background="#1C2033" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="PRO" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Sovereign Deep Recovery Engine" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Source Drive Selector Card -->
                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="SOURCE STORAGE DRIVE" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <Button Content="🔄 Refresh" Command="{Binding RefreshDrivesCommand}"
                                    Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Right" FontSize="11" ToolTip="Rescan connected drives &amp; USB volumes"/>
                        </Grid>

                        <ComboBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}"
                                  Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource BorderDefaultBrush}" Padding="8,6">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="💾" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DriveLetter}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text=" (" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding VolumeLabel}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text=")" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding FileSystem}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding FormattedTotal}" HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Volume Specs & Capacity Meter Card -->
                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,14"
                        DataContext="{Binding SelectedDrive}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="VOLUME CAPACITY" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                            <TextBlock HorizontalAlignment="Right" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}">
                                <Run Text="{Binding FormattedFree, Mode=OneWay}"/>
                                <Run Text=" free of "/>
                                <Run Text="{Binding FormattedTotal, Mode=OneWay}"/>
                            </TextBlock>
                        </Grid>

                        <!-- Capacity Usage Meter -->
                        <Grid Margin="0,2,0,8">
                            <ProgressBar Value="{Binding Converter={StaticResource DriveUsageConverter}}" Maximum="100" Height="6"
                                         Foreground="{DynamicResource PrimaryAccentBrush}" Background="{DynamicResource BgInputBrush}"
                                         BorderThickness="0"/>
                        </Grid>

                        <!-- Hardware & Filesystem Details -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="File System:" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding FileSystem}" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="11"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Cluster Size:" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding ClusterSize, StringFormat='{}{0} Bytes'}" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Sectors/Cluster:" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding SectorsPerCluster}" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                        </Grid>
                        <Grid>
                            <TextBlock Text="Raw Path:" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding DevicePath}" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Recovery Architecture Modes -->
                <StackPanel Grid.Row="3">
                    <TextBlock Text="RECOVERY ARCHITECTURE" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>

                    <RadioButton Style="{StaticResource ModeCardRadioButtonStyle}" GroupName="RecoveryMode"
                                 IsChecked="True" Click="QuickUndelete_Click">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Quick Undelete" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="Scans NTFS $MFT &amp; FAT directory tables for recently purged records."
                                       FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="20,2,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource ModeCardRadioButtonStyle}" GroupName="RecoveryMode"
                                 Click="DeepCarve_Click">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧬" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Deep Raw Carving" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="Byte-level signature carving across unallocated disk clusters."
                                       FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="20,2,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource ModeCardRadioButtonStyle}" GroupName="RecoveryMode"
                                 Click="Vss_Click">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🛡️" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Shadow Explorer" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="Mounts historical Windows VSS shadow copies for deleted files."
                                       FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="20,2,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource ModeCardRadioButtonStyle}" GroupName="RecoveryMode"
                                 Click="Recycle_Click">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗑️" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Recycle Rescue" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="Decodes INFO2 / $I records to restore emptied Recycle Bin items."
                                       FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="20,2,0,0"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Sovereign Safe Barrier Status -->
                <Border Grid.Row="4" Background="#14192A" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="●" Foreground="{DynamicResource SuccessAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Zero-Write Safe Barrier Active" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- RIGHT MAIN RECOVERY WORKSPACE                             -->
        <!-- ========================================================= -->
        <Grid Grid.Column="1" Margin="16,14,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Top Action Header Bar -->
                <RowDefinition Height="Auto"/> <!-- In-Window Notification InfoBar -->
                <RowDefinition Height="Auto"/> <!-- Scan Progress & Telemetry Card -->
                <RowDefinition Height="Auto"/> <!-- Category Chips & Search Toolstrip -->
                <RowDefinition Height="*"/>    <!-- File Candidates Grid + File Inspector -->
                <RowDefinition Height="Auto"/> <!-- Bottom Restoration & Safety Barrier Bar -->
            </Grid.RowDefinitions>

            <!-- 1. Top Action Header Bar -->
            <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CurrentModeTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Border Background="#1D2236" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedDrive.DriveLetter, StringFormat='Target: {0}'}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding CurrentModeDescription}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Scan Action CTA Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="⚡ Start Scan" Command="{Binding StartScanCommand}"
                                Style="{StaticResource AccentButtonStyle}" Height="32" Padding="18,0" Margin="0,0,8,0"/>
                        <Button Content="✕ Cancel Scan" Command="{Binding CancelScanCommand}"
                                Style="{StaticResource DangerButtonStyle}" Height="32" Padding="14,0"
                                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisConverter}}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. In-Window InfoBar Banner -->
            <components:InfoBar Grid.Row="1"
                                Visibility="{Binding IsInfoBarVisible, Converter={StaticResource BoolToVisConverter}}"/>

            <!-- 3. Live Scan Progress & Telemetry Card -->
            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10" Padding="12,10"
                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="{Binding StatusText}" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ThroughputText}" HorizontalAlignment="Right" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                    </Grid>
                    <ProgressBar Grid.Row="1" Value="{Binding ScanProgress}" Maximum="100" Height="6"
                                 Foreground="{DynamicResource PrimaryAccentBrush}" Background="{DynamicResource BgInputBrush}"
                                 BorderThickness="0"/>
                </Grid>
            </Border>

            <!-- 4. Category Filter Chips & Search Toolstrip -->
            <Border Grid.Row="3" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Category Filter Chips -->
                        <ColumnDefinition Width="*"/>    <!-- Search Input -->
                        <ColumnDefinition Width="Auto"/> <!-- Selection Tools -->
                    </Grid.ColumnDefinitions>

                    <!-- Category Filter Chips -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Content="{Binding CountAll, StringFormat='All ({0})'}" GroupName="CategoryFilter"
                                     IsChecked="True" Style="{StaticResource CategoryChipStyle}"
                                     Command="{Binding SetCategoryCommand}" CommandParameter="{x:Static models:FileCategory.All}"/>

                        <RadioButton Content="{Binding CountDocuments, StringFormat='📄 Documents ({0})'}" GroupName="CategoryFilter"
                                     Style="{StaticResource CategoryChipStyle}"
                                     Command="{Binding SetCategoryCommand}" CommandParameter="{x:Static models:FileCategory.Documents}"/>

                        <RadioButton Content="{Binding CountPictures, StringFormat='🖼️ Photos ({0})'}" GroupName="CategoryFilter"
                                     Style="{StaticResource CategoryChipStyle}"
                                     Command="{Binding SetCategoryCommand}" CommandParameter="{x:Static models:FileCategory.Pictures}"/>

                        <RadioButton Content="{Binding CountMedia, StringFormat='🎬 Media ({0})'}" GroupName="CategoryFilter"
                                     Style="{StaticResource CategoryChipStyle}"
                                     Command="{Binding SetCategoryCommand}" CommandParameter="{x:Static models:FileCategory.Videos}"/>

                        <RadioButton Content="{Binding CountArchives, StringFormat='📦 Archives ({0})'}" GroupName="CategoryFilter"
                                     Style="{StaticResource CategoryChipStyle}"
                                     Command="{Binding SetCategoryCommand}" CommandParameter="{x:Static models:FileCategory.Archives}"/>

                        <RadioButton Content="{Binding CountOthers, StringFormat='📁 Others ({0})'}" GroupName="CategoryFilter"
                                     Style="{StaticResource CategoryChipStyle}"
                                     Command="{Binding SetCategoryCommand}" CommandParameter="{x:Static models:FileCategory.Other}"/>
                    </StackPanel>

                    <!-- Search Filter Box -->
                    <TextBox Grid.Column="1" Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderDefaultBrush}" Padding="10,5" Margin="8,0"
                             VerticalAlignment="Center" Height="28"
                             ToolTip="Filter results by filename or extension..."/>

                    <!-- Selection Utility Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Select All" Command="{Binding SelectAllCommand}" 
                                Style="{StaticResource SecondaryButtonStyle}" Height="28" Padding="10,0" Margin="0,0,6,0"/>
                        <Button Content="Deselect All" Command="{Binding DeselectAllCommand}" 
                                Style="{StaticResource SecondaryButtonStyle}" Height="28" Padding="10,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 5. Candidates Grid & Docked File Inspector -->
            <Grid Grid.Row="4" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/> <!-- Inspector Panel -->
                </Grid.RowDefinitions>

                <!-- Virtualized Candidate Files ListView -->
                <ListView Grid.Row="0" ItemsSource="{Binding DisplayFiles}" SelectedItem="{Binding SelectedFile}">
                    <ListView.View>
                        <GridView>
                            <!-- Selection Checkbox -->
                            <GridViewColumn Width="36">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Click="FileCheckBox_Click"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Health Status Pill -->
                            <GridViewColumn Header="Health" Width="105">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#1C2136" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Health}" Foreground="{Binding Health, Converter={StaticResource HealthBrushConverter}}"
                                                       FontSize="10.5" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- File Name with Icon -->
                            <GridViewColumn Header="File Name" Width="280">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Category, Converter={StaticResource CategoryIconConverter}}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Formatted Size (Numeric Right-Alignment per standards) -->
                            <GridViewColumn Header="Size" Width="95">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FormattedSize}" FontFamily="{StaticResource MonospaceFont}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Category -->
                            <GridViewColumn Header="Category" Width="90" DisplayMemberBinding="{Binding Category}"/>

                            <!-- Discovery Method -->
                            <GridViewColumn Header="Method" Width="110" DisplayMemberBinding="{Binding RecoveryMethod}"/>

                            <!-- Original Path -->
                            <GridViewColumn Header="Original Path" Width="260" DisplayMemberBinding="{Binding OriginalPath}"/>

                            <!-- Deleted Timestamp -->
                            <GridViewColumn Header="Deleted Time" Width="130" DisplayMemberBinding="{Binding DeletedTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Docked File Candidate Inspector & Hex Preview Drawer -->
                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="12,10" Margin="0,8,0,0"
                        Visibility="{Binding HasSelectedFile, Converter={StaticResource BoolToVisConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360"/> <!-- Metadata Summary -->
                            <ColumnDefinition Width="*"/>   <!-- Monospace Hex Preview -->
                        </Grid.ColumnDefinitions>

                        <!-- Candidate Metadata Details -->
                        <StackPanel Grid.Column="0" Margin="0,0,16,0" DataContext="{Binding SelectedFile}">
                            <TextBlock Text="CANDIDATE INSPECTOR" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccentBrush}" Margin="0,0,0,6"/>
                            
                            <Grid Margin="0,0,0,3">
                                <TextBlock Text="Target File:" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                <TextBlock Text="{Binding FileName}" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                            </Grid>

                            <Grid Margin="0,0,0,3">
                                <TextBlock Text="Health Assessment:" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                <TextBlock Text="{Binding Health}" HorizontalAlignment="Right" Foreground="{Binding Health, Converter={StaticResource HealthBrushConverter}}" FontWeight="Bold" FontSize="11"/>
                            </Grid>

                            <TextBlock Text="{Binding Health, Converter={StaticResource HealthDescConverter}}"
                                       FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,6"/>

                            <Grid Margin="0,0,0,3">
                                <TextBlock Text="Method / Offset:" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11">
                                    <Run Text="{Binding RecoveryMethod, Mode=OneWay}"/>
                                    <Run Text=" @ 0x"/>
                                    <Run Text="{Binding SourceOffset, StringFormat='{}{0:X8}', Mode=OneWay}"/>
                                </TextBlock>
                            </Grid>

                            <Grid Margin="0,0,0,3">
                                <TextBlock Text="Cluster Extents:" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                <TextBlock Text="{Binding DataExtents.Count, StringFormat='{}{0} runs mapped'}" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                            </Grid>

                            <Grid>
                                <TextBlock Text="MFT Resident:" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                <TextBlock Text="{Binding IsResident, StringFormat='{}{0}'}" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                            </Grid>
                        </StackPanel>

                        <!-- Monospace Hex Viewer Header -->
                        <Border Grid.Column="1" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="10,6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="HEADER SIGNATURE / SECTOR PREVIEW" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Height="85">
                                    <TextBlock Text="{Binding SelectedFilePreviewBytes, Converter={StaticResource HexDumpConverter}}"
                                               FontFamily="{StaticResource MonospaceFont}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 6. Bottom Restoration & Safety Barrier Bar -->
            <Border Grid.Row="5" Style="{StaticResource CardBorderStyle}" Padding="14,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Zero-Write Safety Barrier Alert Banner -->
                        <RowDefinition Height="Auto"/> <!-- Destination Path & Restore CTA Row -->
                    </Grid.RowDefinitions>

                    <!-- Zero-Write Safety Alert Banner -->
                    <Border Grid.Row="0" Margin="0,0,0,10" Padding="10,6" CornerRadius="6"
                            Background="{Binding IsDestinationSafe, Converter={StaticResource SafetyBgConverter}}"
                            BorderBrush="{Binding IsDestinationSafe, Converter={StaticResource SafetyBorderConverter}}"
                            BorderThickness="1">
                        <TextBlock Text="{Binding SafetyMessage}" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{Binding IsDestinationSafe, Converter={StaticResource SafetyBrushConverter}}"/>
                    </Border>

                    <!-- Destination Path & Primary Restore CTA -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Destination Folder Inputs -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Recovery Destination:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Margin="0,0,10,0"/>
                            <TextBox Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource BorderDefaultBrush}" Padding="8,5" Width="380"
                                     VerticalAlignment="Center" Height="30"/>
                            <Button Content="Browse..." Click="BrowseDestination_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" Height="30" Padding="12,0" Margin="6,0,0,0"/>
                            <Button Content="📁 Open Folder" Command="{Binding OpenDestinationCommand}"
                                    Style="{StaticResource GhostButtonStyle}" Height="30" Padding="8,0" Margin="4,0,0,0"
                                    ToolTip="Open restored destination in Windows Explorer"/>
                        </StackPanel>

                        <!-- Primary Restore CTA Button -->
                        <Button Grid.Column="1" Content="{Binding RestoreButtonText}"
                                Command="{Binding RestoreSelectedCommand}"
                                Style="{StaticResource AccentButtonStyle}" Height="36" Padding="22,0" FontSize="13"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
