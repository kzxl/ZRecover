<Window x:Class="ZeroRecover.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ZeroRecover.UI.ViewModels"
        xmlns:models="clr-namespace:ZeroRecover.Core.Models;assembly=ZeroRecover.Core"
        Title="ZeroRecover — Sovereign Deep Data Recovery Suite" 
        Height="800" Width="1200" MinHeight="600" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/> <!-- Left Control Rail -->
            <ColumnDefinition Width="*"/>   <!-- Main Recovery Workspace -->
        </Grid.ColumnDefinitions>

        <!-- Left Navigation & Drive Configuration Rail -->
        <Border Grid.Column="0" Background="{DynamicResource BgCardBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,0,1,0"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Brand Header -->
                    <RowDefinition Height="Auto"/> <!-- Recovery Modes -->
                    <RowDefinition Height="Auto"/> <!-- Drive Selector -->
                    <RowDefinition Height="*"/>    <!-- Volume Info Card -->
                    <RowDefinition Height="Auto"/> <!-- Zero Universe Badge -->
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚡" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="ZeroRecover" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="Sovereign Deep Recovery Engine" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="28,2,0,0"/>
                </StackPanel>

                <!-- Recovery Mode Selector -->
                <StackPanel Grid.Row="1" Margin="0,0,0,20">
                    <TextBlock Text="RECOVERY MODES" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                    
                    <RadioButton Content="🔍 Quick Undelete (MFT/FAT)" IsChecked="{Binding CurrentMode, Converter={x:Null}, Mode=OneWay}"
                                 GroupName="RecoveryMode" Margin="0,0,0,6" Foreground="{DynamicResource TextPrimaryBrush}"
                                 Command="{Binding DataContext.StartScanCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                 CommandParameter="QuickUndelete"
                                 Click="QuickUndelete_Click"/>

                    <RadioButton Content="🧬 Deep Raw Carving" GroupName="RecoveryMode" Margin="0,0,0,6" 
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 Click="DeepCarve_Click"/>

                    <RadioButton Content="🛡️ Shadow Explorer (VSS)" GroupName="RecoveryMode" Margin="0,0,0,6" 
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 Click="Vss_Click"/>

                    <RadioButton Content="🗑️ Recycle Rescue" GroupName="RecoveryMode" Margin="0,0,0,6" 
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 Click="Recycle_Click"/>
                </StackPanel>

                <!-- Target Volume Selector -->
                <StackPanel Grid.Row="2" Margin="0,0,0,16">
                    <TextBlock Text="SOURCE STORAGE DRIVE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}"
                              Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                              Padding="8,6">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DriveLetter}" FontWeight="Bold" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding VolumeLabel}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding FormattedTotal}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Volume Specs Details Card -->
                <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" VerticalAlignment="Top">
                    <StackPanel DataContext="{Binding SelectedDrive}">
                        <TextBlock Text="VOLUME SPECIFICATIONS" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccentBrush}" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="File System:" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding FileSystem}" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="11"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Cluster Size:" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding ClusterSize, StringFormat='{}{0} Bytes'}" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Free Space:" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding FormattedFree}" HorizontalAlignment="Right" Foreground="{DynamicResource SuccessAccentBrush}" FontWeight="Bold" FontSize="11"/>
                        </Grid>
                        <Grid>
                            <TextBlock Text="Device Path:" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding DevicePath}" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Version & Status -->
                <Border Grid.Row="4" Background="#181B2C" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="10,6">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="●" Foreground="{DynamicResource SuccessAccentBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="Zero-Write Safe Barrier Active" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Recovery Workspace -->
        <Grid Grid.Column="1" Margin="16,14,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Top Action Header Bar -->
                <RowDefinition Height="Auto"/> <!-- Scan Progress & Telemetry -->
                <RowDefinition Height="Auto"/> <!-- Filter & Search Toolstrip -->
                <RowDefinition Height="*"/>    <!-- Virtualized File Candidates Grid -->
                <RowDefinition Height="Auto"/> <!-- Bottom Restoration & Safety Barrier Bar -->
            </Grid.RowDefinitions>

            <!-- Top Action Header Bar -->
            <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentModeTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Scan Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="⚡ Start Scan" Command="{Binding StartScanCommand}"
                                Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0"/>
                        <Button Content="✕ Cancel" Command="{Binding CancelScanCommand}"
                                Style="{StaticResource AccentButtonStyle}" Background="#3A1C28" Foreground="#F38BA8"
                                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisConverter}}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Live Scan Progress Bar -->
            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10" Padding="12,8"
                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding ThroughputText}" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                    </Grid>
                    <ProgressBar Grid.Row="1" Value="{Binding ScanProgress}" Maximum="100" Height="6"
                                 Foreground="{DynamicResource PrimaryAccentBrush}" Background="{DynamicResource BgInputBrush}"/>
                </Grid>
            </Border>

            <!-- Filter & Search Toolstrip -->
            <Border Grid.Row="2" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Box -->
                    <TextBox Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderDefaultBrush}" Padding="8,5"
                             ToolTip="Filter results by filename..."/>

                    <!-- Selection Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="Select All" Command="{Binding SelectAllCommand}" 
                                Style="{StaticResource AccentButtonStyle}" Background="{DynamicResource BgCardBrush}" Padding="10,4" Margin="0,0,6,0"/>
                        <Button Content="Deselect All" Command="{Binding DeselectAllCommand}" 
                                Style="{StaticResource AccentButtonStyle}" Background="{DynamicResource BgCardBrush}" Padding="10,4"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Virtualized Candidates Grid -->
            <ListView Grid.Row="3" ItemsSource="{Binding DisplayFiles}" Margin="0,0,0,12">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="40">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Health" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#1C2136" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Health}" Foreground="{Binding Health, Converter={StaticResource HealthBrushConverter}}"
                                                   FontSize="10.5" FontWeight="Bold"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="File Name" Width="280">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding FormattedSize}"/>

                        <GridViewColumn Header="Category" Width="90" DisplayMemberBinding="{Binding Category}"/>

                        <GridViewColumn Header="Method" Width="110" DisplayMemberBinding="{Binding RecoveryMethod}"/>

                        <GridViewColumn Header="Original Path" Width="220" DisplayMemberBinding="{Binding OriginalPath}"/>

                        <GridViewColumn Header="Deleted Time" Width="130" DisplayMemberBinding="{Binding DeletedTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Bottom Restoration & Safety Barrier Bar -->
            <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}" Padding="14,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Destination Folder Row -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Recovery Destination:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                        <TextBox Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderDefaultBrush}" Padding="8,4" Width="400"/>
                        <Button Content="Browse..." Click="BrowseDestination_Click"
                                Style="{StaticResource AccentButtonStyle}" Background="{DynamicResource BgCardBrush}" Margin="6,0,0,0"/>
                    </StackPanel>

                    <!-- Restore CTA Button -->
                    <Button Grid.Row="0" Grid.Column="1" Content="⚡ Restore Selected Files"
                            Command="{Binding RestoreSelectedCommand}"
                            Style="{StaticResource AccentButtonStyle}" Height="34" Padding="18,0"/>

                    <!-- Safety Barrier Message Banner -->
                    <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Padding="8,4" CornerRadius="4"
                            Background="{Binding IsDestinationSafe, Converter={x:Null}}">
                        <TextBlock Text="{Binding SafetyMessage}" FontSize="11"
                                   Foreground="{Binding IsDestinationSafe, Converter={x:Null}}"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
