<Window x:Class="ZRecover.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ZRecover.UI.ViewModels"
        xmlns:components="clr-namespace:ZRecover.UI.Views.Components"
        xmlns:models="clr-namespace:ZRecover.Core.Models;assembly=ZRecover.Core"
        Title="ZRecover — Sovereign Deep Data Recovery Suite" 
        Icon="app.ico"
        Height="850" Width="1300" MinHeight="680" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310"/> <!-- Left Control Rail -->
            <ColumnDefinition Width="*"/>   <!-- Main Recovery Workspace -->
        </Grid.ColumnDefinitions>

        <!-- ========================================================= -->
        <!-- LEFT CONTROL & STORAGE RAIL                               -->
        <!-- ========================================================= -->
        <Border Grid.Column="0" Background="{DynamicResource BgCardBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,0,1,0"
                Padding="16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Brand Header -->
                    <RowDefinition Height="*"/>    <!-- Scrollable Control Cards -->
                    <RowDefinition Height="Auto"/> <!-- Sovereign Safe Barrier Status -->
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="app.png" Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ZRecover" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Border Background="#1C2033" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="PRO" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Sovereign Deep Recovery Engine" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Scrollable Control Cards Area (Locked during scan) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,4,0">

                        <!-- 1. Source Drive & Scan Scope Card (Locked during scan) -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="SOURCE STORAGE DRIVE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <Button Content="🔄 Refresh" Command="{Binding RefreshDrivesCommand}"
                                            IsEnabled="{Binding IsNotScanning}"
                                            Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Right" FontSize="11" ToolTip="Rescan connected drives &amp; USB volumes"/>
                                </Grid>

                                <!-- Drive ComboBox -->
                                <ComboBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}"
                                          IsEnabled="{Binding IsNotScanning}"
                                          Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                          BorderBrush="{DynamicResource BorderDefaultBrush}" Padding="8,6" Margin="0,0,0,10">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="💾" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DriveLetter}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text=" (" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding VolumeLabel}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock Text=")" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding FileSystem}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding FormattedTotal}" HorizontalAlignment="Right"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- Scan Target Scope Switch (Drive vs Folder) -->
                                <TextBlock Text="SCAN SCOPE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton Content="Entire Drive" IsChecked="{Binding IsDriveScope}" GroupName="ScanScope"
                                                 IsEnabled="{Binding IsNotScanning}"
                                                 Style="{StaticResource CategoryChipStyle}" Margin="0,0,3,0"/>
                                    <RadioButton Grid.Column="1" Content="Target Folder" IsChecked="{Binding IsFolderScope}" GroupName="ScanScope"
                                                 IsEnabled="{Binding IsNotScanning}"
                                                 Style="{StaticResource CategoryChipStyle}" Margin="3,0,0,0"/>
                                </Grid>

                                <!-- Folder Scope Input & Quick Presets (Visible when IsFolderScope == true) -->
                                <StackPanel Visibility="{Binding IsFolderScope, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,0,2">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding TargetFolderPath, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsNotScanning}"
                                                 Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderBrush="{DynamicResource BorderDefaultBrush}" Padding="8,4" FontSize="11" Height="28"
                                                 VerticalContentAlignment="Center" Margin="0,0,6,0"
                                                 ToolTip="Specific folder to target recovery"/>
                                        <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseFolderScopeCommand}"
                                                IsEnabled="{Binding IsNotScanning}"
                                                Style="{StaticResource SecondaryButtonStyle}" Height="28" Padding="8,0" FontSize="10.5"/>
                                    </Grid>

                                    <!-- Quick Preset Buttons -->
                                    <TextBlock Text="QUICK PRESET LOCATIONS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,4"/>
                                    <UniformGrid Columns="2">
                                        <Button Content="🖥️ Desktop" Command="{Binding SetPresetScopeCommand}" CommandParameter="Desktop"
                                                IsEnabled="{Binding IsNotScanning}"
                                                Style="{StaticResource GhostButtonStyle}" Height="24" FontSize="10" Margin="0,0,2,4"/>
                                        <Button Content="📥 Downloads" Command="{Binding SetPresetScopeCommand}" CommandParameter="Downloads"
                                                IsEnabled="{Binding IsNotScanning}"
                                                Style="{StaticResource GhostButtonStyle}" Height="24" FontSize="10" Margin="2,0,0,4"/>
                                        <Button Content="📄 Documents" Command="{Binding SetPresetScopeCommand}" CommandParameter="Documents"
                                                IsEnabled="{Binding IsNotScanning}"
                                                Style="{StaticResource GhostButtonStyle}" Height="24" FontSize="10" Margin="0,0,2,0"/>
                                        <Button Content="🗑️ Recycle Bin" Command="{Binding SetPresetScopeCommand}" CommandParameter="RecycleBin"
                                                IsEnabled="{Binding IsNotScanning}"
                                                Style="{StaticResource GhostButtonStyle}" Height="24" FontSize="10" Margin="2,0,0,0"/>
                                    </UniformGrid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 2. Volume Specs & Capacity Meter Card -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,12"
                                DataContext="{Binding SelectedDrive}">
                            <StackPanel>
                                <!-- Title Row + Free Space Indicator -->
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="VOLUME CAPACITY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                                    <TextBlock HorizontalAlignment="Right" FontSize="10.5" Foreground="{DynamicResource SuccessAccentBrush}" FontWeight="SemiBold">
                                        <Run Text="{Binding FormattedFree, Mode=OneWay}"/>
                                        <Run Text=" Free"/>
                                    </TextBlock>
                                </Grid>

                                <!-- Capacity Usage Progress Bar -->
                                <ProgressBar Value="{Binding Mode=OneWay, Converter={StaticResource DriveUsageConverter}}" Maximum="100" Height="6"
                                             Foreground="{DynamicResource PrimaryAccentBrush}" Background="{DynamicResource BgInputBrush}"
                                             BorderThickness="0" Margin="0,2,0,4"/>

                                <!-- Total Size Subtitle -->
                                <TextBlock HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8">
                                    <Run Text="Total Storage: "/>
                                    <Run Text="{Binding FormattedTotal, Mode=OneWay}"/>
                                </TextBlock>

                                <!-- Hardware & Filesystem Details -->
                                <Grid Margin="0,0,0,3">
                                    <TextBlock Text="File System:" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                    <TextBlock Text="{Binding FileSystem}" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="11"/>
                                </Grid>
                                <Grid Margin="0,0,0,3">
                                    <TextBlock Text="Cluster Size:" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                    <TextBlock Text="{Binding ClusterSize, StringFormat='{}{0} Bytes'}" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11"/>
                                </Grid>
                                <Grid Margin="0,0,0,3">
                                    <TextBlock Text="Sectors/Cluster:" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                    <TextBlock Text="{Binding SectorsPerCluster}" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Raw Device:" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                    <TextBlock Text="{Binding DevicePath}" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 3. Recovery Architecture Modes (Locked during scan) -->
                        <StackPanel Margin="0,0,0,4">
                            <TextBlock Text="RECOVERY ARCHITECTURE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>

                            <RadioButton Style="{StaticResource ModeCardRadioButtonStyle}" GroupName="RecoveryMode"
                                         IsEnabled="{Binding IsNotScanning}"
                                         IsChecked="True" Click="QuickUndelete_Click">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔍" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Quick Undelete" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="Scans NTFS $MFT &amp; FAT tables for recently deleted files."
                                               FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="22,2,0,0"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource ModeCardRadioButtonStyle}" GroupName="RecoveryMode"
                                         IsEnabled="{Binding IsNotScanning}"
                                         Click="DeepCarve_Click">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🧬" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Deep Raw Carving" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="Sector-by-sector signature carving across unallocated disk space."
                                               FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="22,2,0,0"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource ModeCardRadioButtonStyle}" GroupName="RecoveryMode"
                                         IsEnabled="{Binding IsNotScanning}"
                                         Click="Vss_Click">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🛡️" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Shadow Explorer" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="Mounts historical Windows VSS shadow copies for deleted files."
                                               FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="22,2,0,0"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource ModeCardRadioButtonStyle}" GroupName="RecoveryMode"
                                         IsEnabled="{Binding IsNotScanning}"
                                         Click="Recycle_Click">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🗑️" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Recycle Rescue" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="Decodes INFO2 / $I records to restore emptied Recycle Bin items."
                                               FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="22,2,0,0"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Safe Barrier Status Footer -->
                <Border Grid.Row="2" Background="#14192A" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="10,8" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="●" Foreground="{DynamicResource SuccessAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Zero-Write Safe Barrier Active" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- RIGHT MAIN RECOVERY WORKSPACE                             -->
        <!-- ========================================================= -->
        <Grid Grid.Column="1" Margin="16,14,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Top Action Header Bar -->
                <RowDefinition Height="Auto"/> <!-- In-Window Notification InfoBar -->
                <RowDefinition Height="Auto"/> <!-- Scan Progress & Telemetry Card -->
                <RowDefinition Height="Auto"/> <!-- Category Chips & Search Toolstrip -->
                <RowDefinition Height="*"/>    <!-- File Candidates Grid + Loading Overlay -->
                <RowDefinition Height="Auto"/> <!-- Bottom Restoration & Safety Barrier Bar -->
            </Grid.RowDefinitions>

            <!-- 1. Top Action Header Bar -->
            <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CurrentModeTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Border Background="#1D2236" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedDrive.DriveLetter, StringFormat='Target: {0}'}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                            </Border>

                            <!-- Elevated Administrator Badge -->
                            <Border Background="#162E28" BorderBrush="{DynamicResource SuccessAccentBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding IsElevated, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="🛡️ Administrator (Raw MFT)" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource SuccessAccentBrush}"/>
                            </Border>

                            <!-- Standard User / Relaunch CTA Button -->
                            <Button Content="🛡️ Run as Admin" Command="{Binding RelaunchAsAdminCommand}"
                                    Style="{StaticResource GhostButtonStyle}" Height="24" Padding="8,0" FontSize="10.5" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding IsNotElevated, Converter={StaticResource BoolToVisConverter}}"
                                    ToolTip="Relaunch with Administrator privileges for raw sector and direct MFT hardware access"/>
                        </StackPanel>
                        <TextBlock Text="{Binding CurrentModeDescription}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Scan Action CTA Buttons (Morphing Start <-> Cancel) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Start Scan Button: Visible when idle -->
                        <Button Content="⚡ Start Scan" Command="{Binding StartScanCommand}"
                                Style="{StaticResource AccentButtonStyle}" Height="34" Padding="20,0"
                                Visibility="{Binding IsNotScanning, Converter={StaticResource BoolToVisConverter}}"/>

                        <!-- Cancel Scan Button: High visibility when scanning -->
                        <Button Content="🛑 Stop / Cancel Scan" Command="{Binding CancelScanCommand}"
                                Style="{StaticResource DangerButtonStyle}" Height="34" Padding="18,0"
                                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisConverter}}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. In-Window InfoBar Banner -->
            <components:InfoBar Grid.Row="1"
                                Visibility="{Binding IsInfoBarVisible, Converter={StaticResource BoolToVisConverter}}"/>

            <!-- 3. Live Scan Progress & Telemetry Card (Active while scanning) -->
            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10" Padding="14,10"
                    Background="#181D33" BorderBrush="{DynamicResource PrimaryAccentBrush}"
                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Status Header + Throughput + Quick Cancel -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚡ SCANNING: " FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                            <TextBlock Text="{Binding StatusText}" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ThroughputText}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource SuccessAccentBrush}" Margin="0,0,14,0"/>
                            <Button Content="✕ Cancel" Command="{Binding CancelScanCommand}"
                                    Style="{StaticResource DangerButtonStyle}" Height="24" Padding="10,0" FontSize="11"/>
                        </StackPanel>
                    </Grid>

                    <!-- Determinate Progress Bar -->
                    <ProgressBar Grid.Row="1" Value="{Binding ScanProgress, Mode=OneWay}" Maximum="100" Height="8"
                                 Foreground="{DynamicResource PrimaryAccentBrush}" Background="{DynamicResource BgInputBrush}"
                                 BorderThickness="0"/>

                    <!-- Indeterminate Animated Glow Pulse -->
                    <ProgressBar Grid.Row="2" IsIndeterminate="True" Height="2" Margin="0,2,0,0"
                                 Foreground="{DynamicResource SecondaryAccentBrush}" Background="Transparent"
                                 BorderThickness="0" Opacity="0.75"/>
                </Grid>
            </Border>

            <!-- 4. Category Filter Chips & Search Toolstrip (Locked during scan) -->
            <Border Grid.Row="3" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Row 0: Category Filter Chips -->
                        <RowDefinition Height="Auto"/> <!-- Row 1: Search Box & Selection Buttons -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Category Filter Chips with Icon + Name + Live Count -->
                    <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  IsEnabled="{Binding IsNotScanning}" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton GroupName="CategoryFilter" IsChecked="True" Style="{StaticResource CategoryChipStyle}"
                                         Command="{Binding SetCategoryCommand}" CommandParameter="{x:Static models:FileCategory.All}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🗂️ All ("/>
                                    <TextBlock Text="{Binding CountAll, Mode=OneWay}"/>
                                    <TextBlock Text=")"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="CategoryFilter" Style="{StaticResource CategoryChipStyle}"
                                         Command="{Binding SetCategoryCommand}" CommandParameter="{x:Static models:FileCategory.Documents}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📄 Documents ("/>
                                    <TextBlock Text="{Binding CountDocuments, Mode=OneWay}"/>
                                    <TextBlock Text=")"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="CategoryFilter" Style="{StaticResource CategoryChipStyle}"
                                         Command="{Binding SetCategoryCommand}" CommandParameter="{x:Static models:FileCategory.Pictures}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🖼️ Photos ("/>
                                    <TextBlock Text="{Binding CountPictures, Mode=OneWay}"/>
                                    <TextBlock Text=")"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="CategoryFilter" Style="{StaticResource CategoryChipStyle}"
                                         Command="{Binding SetCategoryCommand}" CommandParameter="{x:Static models:FileCategory.Videos}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎬 Media ("/>
                                    <TextBlock Text="{Binding CountMedia, Mode=OneWay}"/>
                                    <TextBlock Text=")"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="CategoryFilter" Style="{StaticResource CategoryChipStyle}"
                                         Command="{Binding SetCategoryCommand}" CommandParameter="{x:Static models:FileCategory.Archives}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📦 Archives ("/>
                                    <TextBlock Text="{Binding CountArchives, Mode=OneWay}"/>
                                    <TextBlock Text=")"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="CategoryFilter" Style="{StaticResource CategoryChipStyle}"
                                         Command="{Binding SetCategoryCommand}" CommandParameter="{x:Static models:FileCategory.Other}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📁 Others ("/>
                                    <TextBlock Text="{Binding CountOthers, Mode=OneWay}"/>
                                    <TextBlock Text=")"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Row 1: Search Filter Box & Selection Buttons -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search Filter Box -->
                        <TextBox Grid.Column="0" Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsNotScanning}"
                                 Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderDefaultBrush}" Padding="10,6" Margin="0,0,10,0"
                                 VerticalContentAlignment="Center" Height="30"
                                 ToolTip="Filter results by filename or extension..."/>

                        <!-- Selection Utility Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Select All" Command="{Binding SelectAllCommand}" 
                                    IsEnabled="{Binding IsNotScanning}"
                                    Style="{StaticResource SecondaryButtonStyle}" Height="30" Padding="12,0" Margin="0,0,6,0"/>
                            <Button Content="Deselect All" Command="{Binding DeselectAllCommand}" 
                                    IsEnabled="{Binding IsNotScanning}"
                                    Style="{StaticResource SecondaryButtonStyle}" Height="30" Padding="12,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 5. Candidates Grid + Loading Overlay + Empty State -->
            <Grid Grid.Row="4" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/> <!-- Inspector Panel -->
                </Grid.RowDefinitions>

                <!-- Virtualized Candidate Files DataGrid -->
                <DataGrid Grid.Row="0" ItemsSource="{Binding DisplayFiles}" SelectedItem="{Binding SelectedFile}"
                          IsEnabled="{Binding IsNotScanning}">
                    <DataGrid.Columns>
                        <!-- Selection Checkbox -->
                        <DataGridTemplateColumn Width="38" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Click="FileCheckBox_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Health Status Pill -->
                        <DataGridTemplateColumn Header="Health" Width="95" SortMemberPath="Health">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#1C2136" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Health}" Foreground="{Binding Health, Converter={StaticResource HealthBrushConverter}}"
                                                   FontSize="10.5" FontWeight="Bold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- File Name with Icon & Smart Extension Pill -->
                        <DataGridTemplateColumn Header="File Name" Width="260" SortMemberPath="FileName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Category, Converter={StaticResource CategoryIconConverter}}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                                        <Border Background="#282245" BorderBrush="{DynamicResource SecondaryAccentBrush}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding HasSuggestion, Converter={StaticResource BoolToVisConverter}}"
                                                ToolTip="{Binding SuggestedFileName, StringFormat='Suggested name: {0}'}">
                                            <TextBlock Text="{Binding SuggestedExtension, FallbackValue='✨'}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryAccentBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Smart Format / Suggestion Column -->
                        <DataGridTemplateColumn Header="Format / Smart Suggestion" Width="210" SortMemberPath="DetectedFormat">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DetectedFormat, FallbackValue='Unknown'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding SuggestedFileName, StringFormat='💡 {0}'}" Foreground="{DynamicResource PrimaryAccentBrush}" FontSize="10" FontWeight="SemiBold"
                                                   Visibility="{Binding HasSuggestion, Converter={StaticResource BoolToVisConverter}}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Formatted Size -->
                        <DataGridTemplateColumn Header="Size" Width="85" SortMemberPath="Size">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FormattedSize}" FontFamily="{StaticResource MonospaceFont}"
                                               TextAlignment="Right" HorizontalAlignment="Stretch"
                                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Category -->
                        <DataGridTextColumn Header="Category" Width="90" Binding="{Binding Category}"/>

                        <!-- Method -->
                        <DataGridTextColumn Header="Method" Width="105" Binding="{Binding RecoveryMethod}"/>

                        <!-- Original Path -->
                        <DataGridTextColumn Header="Original Path" Width="240" Binding="{Binding OriginalPath}"/>

                        <!-- Deleted Time -->
                        <DataGridTextColumn Header="Deleted Time" Width="125" Binding="{Binding DeletedTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Scanning / Loading Center Overlay over the Grid -->
                <Border Grid.Row="0" Background="#DD10121E" CornerRadius="8"
                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisConverter}}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource PrimaryAccentBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="32,24"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Width="460">
                        <StackPanel HorizontalAlignment="Center">
                            <!-- Scanning Visual & Status -->
                            <TextBlock Text="🧬" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Deep Scanning in Progress..." FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,14"/>

                            <!-- Progress Bars -->
                            <ProgressBar Value="{Binding ScanProgress, Mode=OneWay}" Maximum="100" Height="8" Width="380"
                                         Foreground="{DynamicResource PrimaryAccentBrush}" Background="{DynamicResource BgInputBrush}"
                                         BorderThickness="0" Margin="0,0,0,4"/>
                            <ProgressBar IsIndeterminate="True" Height="3" Width="380"
                                         Foreground="{DynamicResource SecondaryAccentBrush}" Background="Transparent"
                                         BorderThickness="0" Margin="0,0,0,14"/>

                            <!-- Telemetry Percent & Speed -->
                            <Grid Width="380" Margin="0,0,0,18">
                                <TextBlock Text="{Binding ScanProgress, StringFormat='{}{0:F0}% Completed'}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding ThroughputText}" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessAccentBrush}"/>
                            </Grid>

                            <!-- Prominent Stop / Cancel Button -->
                            <Button Content="🛑 Stop / Cancel Scan" Command="{Binding CancelScanCommand}"
                                    Style="{StaticResource DangerButtonStyle}" Height="34" Padding="24,0" FontSize="12.5"
                                    HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Border>

                <!-- Empty State (When idle with 0 items) -->
                <Border Grid.Row="0" Background="Transparent" IsHitTestVisible="False"
                        Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisConverter}}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" Opacity="0.55">
                        <TextBlock Text="🔍" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="No Files Scanned Yet" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Select a drive on the left and click 'Start Scan' to begin data recovery." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Docked File Candidate Inspector & Dual-Tab Preview Drawer -->
                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="12,10" Margin="0,8,0,0"
                        Visibility="{Binding HasSelectedFile, Converter={StaticResource BoolToVisConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Smart Suggestion Banner -->
                            <RowDefinition Height="*"/>    <!-- Inspector Details & Dual Tab Preview -->
                        </Grid.RowDefinitions>

                        <!-- 1. Heuristic AI Format & Name Recommendation Banner -->
                        <Border Grid.Row="0" Background="#1D1A33" BorderBrush="{DynamicResource SecondaryAccentBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12,7" Margin="0,0,0,10"
                                Visibility="{Binding SelectedFileHasSuggestion, Converter={StaticResource BoolToVisConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="💡 AI File Format &amp; Name Recommendation:" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryAccentBrush}"/>
                                        <Border Background="#2D254E" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedFile.DetectedFormat}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                        <Run Text="Recommended Name: " Foreground="{DynamicResource TextMutedBrush}"/>
                                        <Run Text="{Binding SelectedFile.SuggestedFileName, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Run Text=" (Original: " Foreground="{DynamicResource TextMutedBrush}"/>
                                        <Run Text="{Binding SelectedFile.FileName, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <Run Text=")" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </TextBlock>
                                </StackPanel>

                                <Button Grid.Column="1" Content="✨ Apply Suggested Name" Command="{Binding ApplySuggestedNameCommand}"
                                        Style="{StaticResource AccentButtonStyle}" Height="28" Padding="14,0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- 2. Main Inspector Split: Metadata vs Dual Tab Preview -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="340"/> <!-- Metadata Summary -->
                                <ColumnDefinition Width="*"/>   <!-- Dual Tabbed Viewer -->
                            </Grid.ColumnDefinitions>

                            <!-- Candidate Metadata Details -->
                            <StackPanel Grid.Column="0" Margin="0,0,14,0" DataContext="{Binding SelectedFile}">
                                <TextBlock Text="CANDIDATE INSPECTOR" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccentBrush}" Margin="0,0,0,6"/>
                                
                                <Grid Margin="0,0,0,3">
                                    <TextBlock Text="Target File:" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                    <TextBlock Text="{Binding FileName}" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                </Grid>

                                <Grid Margin="0,0,0,3">
                                    <TextBlock Text="Health Assessment:" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                    <TextBlock Text="{Binding Health}" HorizontalAlignment="Right" Foreground="{Binding Health, Converter={StaticResource HealthBrushConverter}}" FontWeight="Bold" FontSize="11"/>
                                </Grid>

                                <TextBlock Text="{Binding Health, Converter={StaticResource HealthDescConverter}}"
                                           FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,6"/>

                                <Grid Margin="0,0,0,3">
                                    <TextBlock Text="Method / Offset:" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                    <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11">
                                        <Run Text="{Binding RecoveryMethod, Mode=OneWay}"/>
                                        <Run Text=" @ 0x"/>
                                        <Run Text="{Binding SourceOffset, StringFormat='{}{0:X8}', Mode=OneWay}"/>
                                    </TextBlock>
                                </Grid>

                                <Grid Margin="0,0,0,3">
                                    <TextBlock Text="Cluster Extents:" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                    <TextBlock Text="{Binding DataExtents.Count, StringFormat='{}{0} runs mapped'}" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                </Grid>

                                <Grid>
                                    <TextBlock Text="MFT Resident:" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                    <TextBlock Text="{Binding IsResident, StringFormat='{}{0}'}" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                </Grid>
                            </StackPanel>

                            <!-- Dual-Tab Viewer: Formatted Content Preview & Raw Hex Dump -->
                            <Border Grid.Column="1" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="10,6">
                                <TabControl Height="135">
                                    <!-- Tab 1: Formatted Content Preview -->
                                    <TabItem Header="📄 Formatted Content Preview">
                                        <Grid Margin="0,6,0,0">
                                            <!-- When text preview is available -->
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                          Visibility="{Binding SelectedFilePreviewText, Converter={StaticResource StringToVisConverter}}">
                                                <TextBox Text="{Binding SelectedFilePreviewText, Mode=OneWay}"
                                                         IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                         Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{StaticResource MonospaceFont}"
                                                         FontSize="11" TextWrapping="Wrap"/>
                                            </ScrollViewer>

                                            <!-- Fallback notice when file is binary / not text -->
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                        Visibility="{Binding SelectedFilePreviewText, Converter={StaticResource StringToVisConverter}, ConverterParameter=Invert}">
                                                <TextBlock Text="🔍 Binary payload detected" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding SelectedFile.DetectedFormat, StringFormat='Format: {0}'}" FontSize="11" Foreground="{DynamicResource PrimaryAccentBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                <TextBlock Text="Switch to 'Raw Hex &amp; Sector Dump' tab to inspect raw signature bytes." FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </TabItem>

                                    <!-- Tab 2: Visual Image Preview -->
                                    <TabItem Header="🖼️ Visual Image Preview">
                                        <Grid Margin="0,6,0,0">
                                            <!-- When image is available -->
                                            <Grid Visibility="{Binding IsSelectedFileImage, Converter={StaticResource BoolToVisConverter}}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <Border Grid.Row="0" Background="#1B2034" CornerRadius="4" Padding="6,2" Margin="0,0,0,4" HorizontalAlignment="Left">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="📐 Resolution: " FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                                        <TextBlock Text="{Binding SelectedFileImageDimensions}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                                                    </StackPanel>
                                                </Border>

                                                <Border Grid.Row="1" Background="#0C0E17" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="4">
                                                    <Image Source="{Binding SelectedFileImageSource}" Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" MaxHeight="85"/>
                                                </Border>
                                            </Grid>

                                            <!-- Fallback when selected candidate is not an image -->
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                        Visibility="{Binding IsNotSelectedFileImage, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock Text="Non-image candidate" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Check 'Formatted Content Preview' or 'Raw Hex Dump' tab." FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </TabItem>

                                    <!-- Tab 3: Raw Hex & Sector Dump -->
                                    <TabItem Header="🔢 Raw Hex &amp; Sector Dump">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding SelectedFilePreviewBytes, Converter={StaticResource HexDumpConverter}}"
                                                       FontFamily="{StaticResource MonospaceFont}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </ScrollViewer>
                                    </TabItem>
                                </TabControl>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 6. Bottom Restoration & Safety Barrier Bar -->
            <Border Grid.Row="5" Style="{StaticResource CardBorderStyle}" Padding="14,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Zero-Write Safety Barrier Alert Banner -->
                        <RowDefinition Height="Auto"/> <!-- Destination Path & Restore CTA Row -->
                        <RowDefinition Height="Auto"/> <!-- Structure Preserving Restore Option -->
                    </Grid.RowDefinitions>

                    <!-- Zero-Write Safety Alert Banner -->
                    <Border Grid.Row="0" Margin="0,0,0,10" Padding="12,7" CornerRadius="6"
                            Background="{Binding IsDestinationSafe, Mode=OneWay, Converter={StaticResource SafetyBgConverter}}"
                            BorderBrush="{Binding IsDestinationSafe, Mode=OneWay, Converter={StaticResource SafetyBorderConverter}}"
                            BorderThickness="1">
                        <TextBlock Text="{Binding SafetyMessage}" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{Binding IsDestinationSafe, Mode=OneWay, Converter={StaticResource SafetyBrushConverter}}"/>
                    </Border>

                    <!-- Destination Path & Primary Restore CTA -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/> <!-- Label -->
                            <ColumnDefinition Width="*"/>    <!-- Stretchy TextBox -->
                            <ColumnDefinition Width="Auto"/> <!-- Buttons -->
                            <ColumnDefinition Width="Auto"/> <!-- CTA Restore -->
                        </Grid.ColumnDefinitions>

                        <!-- Label -->
                        <TextBlock Grid.Column="0" Text="Recovery Destination:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Margin="0,0,10,0"/>

                        <!-- Stretchy Destination Input (Locked during scan) -->
                        <TextBox Grid.Column="1" Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsNotScanning}"
                                 Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderDefaultBrush}" Padding="10,4"
                                 VerticalContentAlignment="Center" Height="32" Margin="0,0,8,0"/>

                        <!-- Browse & Open Action Buttons (Locked during scan) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <Button Content="Browse..." Click="BrowseDestination_Click"
                                    IsEnabled="{Binding IsNotScanning}"
                                    Style="{StaticResource SecondaryButtonStyle}" Height="32" Padding="14,0" Margin="0,0,6,0"/>
                            <Button Content="📁 Open Folder" Command="{Binding OpenDestinationCommand}"
                                    IsEnabled="{Binding IsNotScanning}"
                                    Style="{StaticResource GhostButtonStyle}" Height="32" Padding="10,0"
                                    ToolTip="Open recovery destination in Windows Explorer"/>
                        </StackPanel>

                        <!-- Primary Restore CTA Button (Locked during scan) -->
                        <Button Grid.Column="3" Content="{Binding RestoreButtonText}"
                                Command="{Binding RestoreSelectedCommand}"
                                IsEnabled="{Binding CanRestore}"
                                Style="{StaticResource AccentButtonStyle}" Height="36" Padding="20,0" FontSize="12.5"/>
                    </Grid>

                    <!-- Preserve Original Folder Structure Option -->
                    <DockPanel Grid.Row="2" Margin="0,8,0,0">
                        <CheckBox Content="Preserve Original Folder Hierarchy (Recreate relative subfolders)"
                                  IsChecked="{Binding PreserveFolderStructure}"
                                  IsEnabled="{Binding IsNotScanning}"
                                  Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="💡 Reconstructs full directory trees inside destination folder"
                                   HorizontalAlignment="Right" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
